{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "\"Segoe UI\", \"Malgun Gothic\", \"Malgun Gothic UI\", \"Apple SD Gothic Neo\", system-ui, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#dbeafe",
    "primaryTextColor": "#0f172a",
    "primaryBorderColor": "#3b82f6",
    "secondaryColor": "#e2e8f0",
    "secondaryTextColor": "#1e293b",
    "tertiaryColor": "#f8fafc",
    "lineColor": "#64748b",
    "textColor": "#0f172a",
    "mainBkg": "#ffffff",
    "secondBkg": "#f1f5f9",
    "border1": "#cbd5e1",
    "border2": "#94a3b8",
    "clusterBkg": "#f1f5f9",
    "clusterBorder": "#cbd5e1",
    "edgeLabelBackground": "#ffffff",
    "titleColor": "#0f172a",
    "actorBkg": "#eff6ff",
    "actorBorder": "#3b82f6",
    "actorTextColor": "#0f172a",
    "actorLineColor": "#94a3b8",
    "signalColor": "#334155",
    "signalTextColor": "#0f172a",
    "labelBoxBkgColor": "#e0e7ff",
    "labelBoxBorderColor": "#6366f1",
    "labelTextColor": "#0f172a",
    "loopTextColor": "#0f172a",
    "activationBorderColor": "#3b82f6",
    "activationBkgColor": "#bfdbfe",
    "noteBkgColor": "#fef3c7",
    "noteTextColor": "#0f172a",
    "noteBorderColor": "#f59e0b"
  },
  "flowchart": {
    "useMaxWidth": true,
    "htmlLabels": true,
    "curve": "basis",
    "padding": 16,
    "nodeSpacing": 72,
    "rankSpacing": 68,
    "diagramPadding": 28
  },
  "sequence": {
    "useMaxWidth": true,
    "diagramMarginX": 40,
    "diagramMarginY": 16,
    "actorMargin": 64,
    "boxMargin": 12,
    "boxTextMargin": 8,
    "messageMargin": 44,
    "width": 200,
    "height": 52,
    "mirrorActors": true
  }
}
