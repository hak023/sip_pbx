# =============================================================================
# SIP PBX AI 보이스봇 - 환경 변수 설정
# =============================================================================
# 이 파일을 .env로 복사하여 실제 값으로 채워주세요
# cp env.example .env
#
# ⚠️ 주의: .env 파일은 절대 Git에 커밋하지 마세요!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud 설정 (필수)
# -----------------------------------------------------------------------------
# Google Cloud 프로젝트 ID
# 확인: https://console.cloud.google.com/
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Service Account 인증 키 파일 경로
# 생성 방법:
#   1. https://console.cloud.google.com/iam-admin/serviceaccounts
#   2. Service Account 생성
#   3. 키 생성 (JSON) → credentials/gcp-key.json에 저장
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-key.json

# Gemini API 키 (필수 - Gemini 1.5 Flash 사용)
# 발급: https://aistudio.google.com/app/apikey
# 모델: gemini-1.5-flash (권장 - Pro 대비 17배 저렴, 2~3배 빠름)
# 💰 비용: 100만 토큰당 $0.075(입력)/$0.30(출력)
# 🎁 무료 할당량: 일 1,500 요청 (소규모 서비스는 무료로 충분)
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# Vector DB - Pinecone (프로덕션 사용 시)
# -----------------------------------------------------------------------------
# Pinecone API 키
# 발급: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=knowledge-base

# -----------------------------------------------------------------------------
# Vector DB - ChromaDB (로컬 개발 - 환경 변수 불필요)
# -----------------------------------------------------------------------------
# ChromaDB는 로컬 파일 시스템 사용, 별도 설정 불필요

# -----------------------------------------------------------------------------
# OpenAI (선택 - 대체 Embedding 사용 시)
# -----------------------------------------------------------------------------
# OpenAI API 키 (Embedding 대안)
# 발급: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-key

# -----------------------------------------------------------------------------
# 모니터링 (선택)
# -----------------------------------------------------------------------------
# Prometheus 설정
PROMETHEUS_PORT=9090

# Grafana URL
GRAFANA_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 보안 (선택)
# -----------------------------------------------------------------------------
# 암호화 키 (녹음 파일 암호화용)
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-with-fernet

# Webhook Secret (Webhook 서명 검증용)
WEBHOOK_SECRET=change-me-in-production

# Admin API 키
ADMIN_API_KEY=change-me-in-production

# -----------------------------------------------------------------------------
# 개발/디버그 (선택)
# -----------------------------------------------------------------------------
# 로그 레벨
LOG_LEVEL=INFO

# 디버그 모드
DEBUG=false

# RTP 송신 TSV는 config.yaml 의 media.rtp_tx_debug / media.rtp_tx_debug_path 사용
#
# AI 묵음 RTP 킵얼라이브: 기본은 config.yaml media.ai_rtp_silence_keepalive (true).
# 환경변수를 **설정한 경우에만** 아래가 우선합니다.
# SIPPBX_AI_RTP_SILENCE_KEEPALIVE=0   # 끔
# SIPPBX_AI_RTP_KEEPALIVE_INTERVAL_SEC=8

# -----------------------------------------------------------------------------
# 사용 예시 (실제 값으로 변경)
# -----------------------------------------------------------------------------
# GCP_PROJECT_ID=sip-pbx-ai-prod
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/sip-pbx-ai-sa-key.json
# GEMINI_API_KEY=AIzaSyAaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPp
# PINECONE_API_KEY=12345678-abcd-1234-abcd-123456789abc
# PINECONE_ENVIRONMENT=us-west1-gcp
# ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz1234567890ABCD=

